{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "The Prometheus datasource scraping your service",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "breakwater",
  "description": "Resilience signals from the breakwater Prometheus adapter: circuit states, execution outcomes, latency percentiles and fast rejections, split by policy name.",
  "tags": ["breakwater", "resilience"],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Circuit state",
      "description": "One box per circuit that has transitioned at least once — a circuit that never left closed shows no box yet, which is the healthy case. 'open' means requests are being rejected without execution.",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "max by (name, state) (breakwater_circuit_state == 1)",
          "legendFormat": "{{name}}: {{state}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "textMode": "name",
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*: open" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*: half-open" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*: isolated" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Executions per second, by outcome",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (name, outcome) (rate(breakwater_executions_total[$__rate_interval]))",
          "legendFormat": "{{name}} — {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Pipeline duration, p50 / p95",
      "description": "Whole-pipeline time: retries and backoff delays included.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, name) (rate(breakwater_execution_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{name}} p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le, name) (rate(breakwater_execution_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{name}} p50",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Fast rejections per second, by reason",
      "description": "Requests refused without executing: open circuit, manual isolation, full bulkhead, exhausted rate limit.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (name, reason) (rate(breakwater_rejections_total[$__rate_interval]))",
          "legendFormat": "{{name}} — {{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Recovery activity: retries, timeouts, fallbacks",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (name) (rate(breakwater_retries_total[$__rate_interval]))",
          "legendFormat": "{{name}} retries",
          "refId": "A"
        },
        {
          "expr": "sum by (name) (rate(breakwater_timeouts_total[$__rate_interval]))",
          "legendFormat": "{{name}} timeouts",
          "refId": "B"
        },
        {
          "expr": "sum by (name) (rate(breakwater_fallbacks_total[$__rate_interval]))",
          "legendFormat": "{{name}} fallbacks",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "cps" }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Circuit transitions",
      "description": "Spikes of closed→open are incidents; half-open→closed are recoveries.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (name, from, to) (increase(breakwater_circuit_transitions_total[$__rate_interval]))",
          "legendFormat": "{{name}}: {{from}} → {{to}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    }
  ]
}
